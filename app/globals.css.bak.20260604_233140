@tailwind base;
@tailwind components;
@tailwind utilities;

html { -webkit-text-size-adjust: 100%; }
body { background: #f8fafc; }
* { touch-action: manipulation; }
input, button, textarea, select { font-size: 16px; }

/* Global light/dark mode support */
html.dark body {
  background: #020617;
  color: #e5e7eb;
}

html.dark .bg-white {
  background-color: #0f172a !important;
}

html.dark .bg-gray-100 {
  background-color: #020617 !important;
}

html.dark .bg-gray-50 {
  background-color: #111827 !important;
}

html.dark .text-gray-900,
html.dark .text-gray-800,
html.dark .text-slate-700,
html.dark .text-slate-600 {
  color: #f8fafc !important;
}

html.dark .text-gray-700,
html.dark .text-gray-600,
html.dark .text-gray-500,
html.dark .text-slate-500 {
  color: #cbd5e1 !important;
}

html.dark .border,
html.dark .border-b,
html.dark .border-gray-200,
html.dark .border-blue-100,
html.dark .border-purple-100 {
  border-color: #334155 !important;
}

html.dark .shadow,
html.dark .shadow-xl,
html.dark .shadow-2xl,
html.dark .shadow-lg,
html.dark .shadow-sm {
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
}

html.dark input,
html.dark textarea,
html.dark select {
  background-color: #020617 !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

html.dark input::placeholder,
html.dark textarea::placeholder {
  color: #94a3b8 !important;
}

html.dark .from-blue-50,
html.dark .from-purple-50 {
  --tw-gradient-from: #0f172a var(--tw-gradient-from-position) !important;
  --tw-gradient-to: rgb(15 23 42 / 0) var(--tw-gradient-to-position) !important;
  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
}

html.dark .to-sky-50,
html.dark .to-indigo-50 {
  --tw-gradient-to: #111827 var(--tw-gradient-to-position) !important;
}

html.dark .bg-blue-50,
html.dark .bg-purple-50 {
  background-color: #0f172a !important;
}

html.dark .bg-blue-100,
html.dark .bg-purple-100 {
  background-color: #1e3a8a !important;
}

html.dark .text-blue-800,
html.dark .text-purple-800,
html.dark .text-blue-700,
html.dark .text-purple-700 {
  color: #bfdbfe !important;
}

/* Dark mode for number grid */
html.dark .bg-gray-200 {
  background-color: #334155 !important;
  color: #f8fafc !important;
  border-color: #475569 !important;
}

html.dark .hover\:bg-gray-300:hover {
  background-color: #475569 !important;
}

html.dark .bg-blue-500 {
  background-color: #2563eb !important;
  color: #ffffff !important;
}

html.dark .bg-orange-400 {
  background-color: #f97316 !important;
  color: #111827 !important;
}

html.dark .bg-yellow-400 {
  background-color: #eab308 !important;
  color: #111827 !important;
}

html.dark .bg-green-600 {
  background-color: #16a34a !important;
  color: #ffffff !important;
}

/* ================================
   GLOBAL DARK MODE CONTRAST FIX
   Keeps existing layout/logic intact
================================ */

html.dark {
  background: #020617;
}

html.dark body {
  background: #020617 !important;
  color: #e5e7eb !important;
}

/* Main backgrounds */
html.dark .bg-white,
html.dark .bg-gray-50,
html.dark .bg-gray-100,
html.dark .bg-slate-50,
html.dark .bg-slate-100 {
  background-color: #0f172a !important;
}

/* Cards / sections with soft colors */
html.dark .bg-blue-50,
html.dark .bg-sky-50,
html.dark .bg-indigo-50,
html.dark .bg-purple-50,
html.dark .bg-red-50,
html.dark .bg-green-50,
html.dark .bg-yellow-50 {
  background-color: #111827 !important;
}

/* Gradient sections */
html.dark .from-blue-50,
html.dark .from-purple-50,
html.dark .from-indigo-50,
html.dark .from-sky-50 {
  --tw-gradient-from: #0f172a var(--tw-gradient-from-position) !important;
  --tw-gradient-to: rgb(15 23 42 / 0) var(--tw-gradient-to-position) !important;
  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
}

html.dark .to-sky-50,
html.dark .to-indigo-50,
html.dark .to-blue-50,
html.dark .to-purple-50 {
  --tw-gradient-to: #111827 var(--tw-gradient-to-position) !important;
}

/* General text contrast */
html.dark .text-gray-950,
html.dark .text-gray-900,
html.dark .text-gray-800,
html.dark .text-slate-900,
html.dark .text-slate-800,
html.dark .text-slate-700 {
  color: #f8fafc !important;
}

html.dark .text-gray-700,
html.dark .text-gray-600,
html.dark .text-gray-500,
html.dark .text-gray-400,
html.dark .text-slate-600,
html.dark .text-slate-500,
html.dark .text-slate-400 {
  color: #cbd5e1 !important;
}

/* Colored text should stay readable */
html.dark .text-blue-900,
html.dark .text-blue-800,
html.dark .text-blue-700,
html.dark .text-purple-900,
html.dark .text-purple-800,
html.dark .text-purple-700,
html.dark .text-indigo-900,
html.dark .text-indigo-800,
html.dark .text-indigo-700 {
  color: #bfdbfe !important;
}

html.dark .text-green-900,
html.dark .text-green-800,
html.dark .text-green-700 {
  color: #bbf7d0 !important;
}

html.dark .text-red-900,
html.dark .text-red-800,
html.dark .text-red-700,
html.dark .text-red-600 {
  color: #fecaca !important;
}

html.dark .text-yellow-900,
html.dark .text-yellow-800,
html.dark .text-yellow-700 {
  color: #fef3c7 !important;
}

/* Borders */
html.dark .border,
html.dark .border-b,
html.dark .border-t,
html.dark .border-gray-100,
html.dark .border-gray-200,
html.dark .border-gray-300,
html.dark .border-slate-100,
html.dark .border-slate-200,
html.dark .border-blue-100,
html.dark .border-purple-100,
html.dark .border-indigo-100 {
  border-color: #334155 !important;
}

/* Inputs */
html.dark input,
html.dark textarea,
html.dark select {
  background-color: #020617 !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

html.dark input::placeholder,
html.dark textarea::placeholder {
  color: #94a3b8 !important;
}

/* Tables */
html.dark table,
html.dark thead,
html.dark tbody,
html.dark tr,
html.dark td,
html.dark th {
  color: #e5e7eb !important;
}

html.dark thead,
html.dark .bg-gray-50 {
  background-color: #111827 !important;
}

html.dark tr:hover,
html.dark .hover\:bg-gray-50:hover {
  background-color: #1e293b !important;
}

/* Modals */
html.dark .rounded-2xl.bg-white,
html.dark .rounded-xl.bg-white {
  background-color: #0f172a !important;
  color: #e5e7eb !important;
}

/* Badges and pills */
html.dark .bg-blue-100 {
  background-color: #1e3a8a !important;
  color: #dbeafe !important;
}

html.dark .bg-purple-100 {
  background-color: #581c87 !important;
  color: #f3e8ff !important;
}

html.dark .bg-green-100 {
  background-color: #14532d !important;
  color: #dcfce7 !important;
}

html.dark .bg-yellow-100 {
  background-color: #713f12 !important;
  color: #fef3c7 !important;
}

html.dark .bg-red-100 {
  background-color: #7f1d1d !important;
  color: #fee2e2 !important;
}

/* Number grid contrast */
html.dark .bg-gray-200 {
  background-color: #334155 !important;
  color: #f8fafc !important;
  border-color: #475569 !important;
}

html.dark .hover\:bg-gray-300:hover {
  background-color: #475569 !important;
}

/* Buttons */
html.dark button.bg-white {
  background-color: #1e293b !important;
  color: #f8fafc !important;
}

html.dark button.bg-gray-200 {
  background-color: #334155 !important;
  color: #f8fafc !important;
}

/* Shadows */
html.dark .shadow,
html.dark .shadow-sm,
html.dark .shadow-md,
html.dark .shadow-lg,
html.dark .shadow-xl,
html.dark .shadow-2xl {
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
}

/* Dark mode contrast fix for Selected Numbers panel */
html.dark aside .bg-blue-50 {
  background-color: #172554 !important;
}

html.dark aside .text-blue-950,
html.dark aside .text-blue-900,
html.dark aside .text-blue-800,
html.dark aside .text-blue-700 {
  color: #dbeafe !important;
}

html.dark aside .border-blue-200,
html.dark aside .border-blue-100 {
  border-color: #60a5fa !important;
}

html.dark aside strong,
html.dark aside b {
  color: #f8fafc !important;
}
