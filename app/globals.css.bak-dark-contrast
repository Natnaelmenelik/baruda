@tailwind base;
@tailwind components;
@tailwind utilities;

html { -webkit-text-size-adjust: 100%; }
body { background: #f8fafc; }
* { touch-action: manipulation; }
input, button, textarea, select { font-size: 16px; }

/* Global light/dark mode support */
html.dark body {
  background: #020617;
  color: #e5e7eb;
}

html.dark .bg-white {
  background-color: #0f172a !important;
}

html.dark .bg-gray-100 {
  background-color: #020617 !important;
}

html.dark .bg-gray-50 {
  background-color: #111827 !important;
}

html.dark .text-gray-900,
html.dark .text-gray-800,
html.dark .text-slate-700,
html.dark .text-slate-600 {
  color: #f8fafc !important;
}

html.dark .text-gray-700,
html.dark .text-gray-600,
html.dark .text-gray-500,
html.dark .text-slate-500 {
  color: #cbd5e1 !important;
}

html.dark .border,
html.dark .border-b,
html.dark .border-gray-200,
html.dark .border-blue-100,
html.dark .border-purple-100 {
  border-color: #334155 !important;
}

html.dark .shadow,
html.dark .shadow-xl,
html.dark .shadow-2xl,
html.dark .shadow-lg,
html.dark .shadow-sm {
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
}

html.dark input,
html.dark textarea,
html.dark select {
  background-color: #020617 !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

html.dark input::placeholder,
html.dark textarea::placeholder {
  color: #94a3b8 !important;
}

html.dark .from-blue-50,
html.dark .from-purple-50 {
  --tw-gradient-from: #0f172a var(--tw-gradient-from-position) !important;
  --tw-gradient-to: rgb(15 23 42 / 0) var(--tw-gradient-to-position) !important;
  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
}

html.dark .to-sky-50,
html.dark .to-indigo-50 {
  --tw-gradient-to: #111827 var(--tw-gradient-to-position) !important;
}

html.dark .bg-blue-50,
html.dark .bg-purple-50 {
  background-color: #0f172a !important;
}

html.dark .bg-blue-100,
html.dark .bg-purple-100 {
  background-color: #1e3a8a !important;
}

html.dark .text-blue-800,
html.dark .text-purple-800,
html.dark .text-blue-700,
html.dark .text-purple-700 {
  color: #bfdbfe !important;
}

/* Dark mode for number grid */
html.dark .bg-gray-200 {
  background-color: #334155 !important;
  color: #f8fafc !important;
  border-color: #475569 !important;
}

html.dark .hover\:bg-gray-300:hover {
  background-color: #475569 !important;
}

html.dark .bg-blue-500 {
  background-color: #2563eb !important;
  color: #ffffff !important;
}

html.dark .bg-orange-400 {
  background-color: #f97316 !important;
  color: #111827 !important;
}

html.dark .bg-yellow-400 {
  background-color: #eab308 !important;
  color: #111827 !important;
}

html.dark .bg-green-600 {
  background-color: #16a34a !important;
  color: #ffffff !important;
}
