export const dynamic = 'force-dynamic';
export const revalidate = 0;

import { NextResponse } from 'next/server';
import { sql } from '@/lib/db/sql';

async function getGridSize() {
  const rows = await sql`
    SELECT value FROM settings
    WHERE key = 'grid_size'
    LIMIT 1
  `;

  const gridSize = Number(rows?.[0]?.value);
  return Number.isFinite(gridSize) && gridSize > 0 ? gridSize : 2000;
}

export async function GET() {
  try {
    const gridSize = await getGridSize();

    const approvedRows = await sql`
      SELECT number
      FROM submissions
      WHERE status = 'approved'
    `;

    const lockedRows = await sql`
      SELECT number
      FROM number_locks
      WHERE expires_at > NOW()
    `;

    const approvedNumbers = new Set(
      approvedRows.map((row: any) => Number(row.number))
    );

    const lockedNumbers = new Set(
      lockedRows.map((row: any) => Number(row.number))
    );

    const numbers = Array.from({ length: gridSize }, (_, index) => {
      const number = index + 1;

      return {
        number,
        isTaken: approvedNumbers.has(number),
        isLocked: lockedNumbers.has(number),
      };
    });

    return NextResponse.json(
      {
        gridSize,
        numbers,
      },
      {
        headers: {
          'Cache-Control': 'no-store, no-cache, must-revalidate',
        },
      }
    );
  } catch (error: any) {
    return NextResponse.json(
      { error: error.message || 'Failed to load numbers' },
      { status: 500 }
    );
  }
}
