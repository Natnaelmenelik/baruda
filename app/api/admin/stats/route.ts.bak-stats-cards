export const dynamic = 'force-dynamic';
export const revalidate = 0;

import { NextResponse } from 'next/server';
import { sql } from '@/lib/db/sql';
import { requireAdmin } from '@/lib/auth/server';

async function getGridSize() {
  const rows = await sql`
    SELECT value FROM settings
    WHERE key = 'grid_size'
    LIMIT 1
  `;

  const gridSize = Number(rows?.[0]?.value);
  return Number.isFinite(gridSize) && gridSize > 0 ? gridSize : 2000;
}

export async function GET(req: Request) {
  try {
    await requireAdmin(req);

    const approvedRows = await sql`
      SELECT COUNT(*)::int AS count
      FROM submissions
      WHERE status = 'approved'
    `;

    const pendingRows = await sql`
      SELECT COUNT(*)::int AS count
      FROM submissions
      WHERE status = 'pending'
    `;

    const rejectedRows = await sql`
      SELECT COUNT(*)::int AS count
      FROM submissions
      WHERE status = 'rejected'
    `;

    const soldRows = await sql`
      SELECT COUNT(DISTINCT number)::int AS sold
      FROM submissions
      WHERE status = 'approved'
    `;

    const approved = Number(approvedRows?.[0]?.count || 0);
    const pending = Number(pendingRows?.[0]?.count || 0);
    const rejected = Number(rejectedRows?.[0]?.count || 0);
    const sold = Number(soldRows?.[0]?.sold || 0);
    const gridSize = await getGridSize();

    return NextResponse.json(
      {
        approved,
        pending,
        rejected,
        sold,
        gridSize,
        numbersLeft: Math.max(gridSize - sold, 0),
      },
      {
        headers: {
          'Cache-Control': 'no-store, no-cache, must-revalidate',
        },
      }
    );
  } catch (error: any) {
    return NextResponse.json(
      { error: error.message || 'Failed to load stats' },
      { status: error.message === 'Forbidden' ? 403 : 500 }
    );
  }
}
