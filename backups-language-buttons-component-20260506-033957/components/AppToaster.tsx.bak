'use client';

import { Toaster } from 'react-hot-toast';

export default function AppToaster() {
  return (
    <Toaster
      position="top-center"
      toastOptions={{
        duration: 3500,
        style: {
          zIndex: 999999,
          borderRadius: '14px',
          padding: '12px 16px',
          fontSize: '14px',
          fontWeight: 600,
          background: '#111827',
          color: '#fff',
        },
        success: {
          style: { background: '#16a34a', color: '#fff' },
        },
        error: {
          style: { background: '#dc2626', color: '#fff' },
        },
        loading: {
          style: { background: '#2563eb', color: '#fff' },
        },
      }}
    />
  );
}
